#!/bin/bash
# Ask Cass a question.
#
#   askcass "how many agents are disconnected right now?"
#   askcass -model llama3.3:latest "what is broken on dss01?"
#
# This existed for a while as a hand-written file in one person's ~/bin and
# nowhere else, so the second contributor to join the project did not have it
# and had no way to discover it. It belongs in the repository.
#
# It rebuilds before every run. That costs a fraction of a second once Go's
# cache is warm and removes a whole class of confusion: the ~/bin copy it
# replaces was a binary compiled on 28 August and still being used on the 30th,
# two days and four connector changes later, silently answering with behaviour
# that no longer existed in the source tree.
set -euo pipefail

# Resolve through the symlink so this works when linked into ~/bin.
target=${BASH_SOURCE[0]}
while [ -L "$target" ]; do
	link=$(readlink "$target")
	case $link in
	/*) target=$link ;;
	*) target=$(dirname "$target")/$link ;;
	esac
done
ROOT=$(cd "$(dirname "$target")/.." && pwd)

# shellcheck source=bin/lib/config.sh
. "$ROOT/bin/lib/config.sh"

ENV_FILE=$(cass_config_path env CASS_ENV)
if [ -r "$ENV_FILE" ]; then
	# shellcheck disable=SC1090
	. "$ENV_FILE"
else
	echo "askcass: no environment file at $ENV_FILE" >&2
	echo "askcass: see docs/onboarding.md, section 2" >&2
	exit 2
fi

# Either spelling satisfies the check. Naming only the new one would tell a
# contributor whose env file predates the rename that a variable they have set
# is missing, which sends them to fix something that is not broken.
missing=""
for name in CASS_MINDROUTER_ENDPOINT MINDROUTER_API_KEY; do
	eval "value=\${$name:-}"
	if [ -z "$value" ]; then
		eval "value=\${SROIAAA_${name#CASS_}:-}"
		[ -z "$value" ] || cass_warn_legacy "SROIAAA_${name#CASS_}" "$name"
	fi
	[ -n "$value" ] || missing="$missing $name"
done
if [ -n "$missing" ]; then
	echo "askcass: missing from the environment:$missing" >&2
	echo "askcass: every line in $ENV_FILE needs 'export'; a variable that is only set" >&2
	echo "askcass: is not inherited by the program you are running" >&2
	exit 2
fi

# A personal policy overrides the repository's, but the repository's is a real
# default rather than a placeholder -- the two were byte-identical on the one
# host where a personal copy existed, so requiring one was ceremony.
POLICY=$(cass_config_path policy.json CASS_POLICY)
[ -r "$POLICY" ] || POLICY=$ROOT/configs/broker-policy.example.json

BIN=${CASS_BIN:-${SROIAAA_BIN:-$ROOT/runtime}}
mkdir -p "$BIN"
# The build must run inside the module. Naming the package by absolute path is
# not enough: go resolves go.mod from the working directory, and this script is
# meant to be run from wherever you happen to be standing.
(cd "$ROOT" && go build -o "$BIN/cass-chat" ./cmd/cass-chat)

exec "$BIN/cass-chat" -policy "$POLICY" -wazuh-insecure "$@"
