[Unit]
Description=SSH forward to the Cassandra endpoint agent on winston
Documentation=https://github.com/bindatype/cassandra
# The forward is useless before the network is up, and Restart=always would
# otherwise spend the first half-minute of every boot failing and backing off.
After=network-online.target
Wants=network-online.target

[Service]
User=glenamac
Type=exec

# StrictHostKeyChecking=yes is the load-bearing option here. This whole
# transport is http-over-ssh rather than https, and what makes that defensible
# is that SSH authenticates the far host. Accepting a changed key automatically
# would remove the only thing standing in for a certificate -- so a changed key
# must fail and keep failing, loudly, rather than reconnect to whatever is
# now answering.
#
# ExitOnForwardFailure=yes so that a session which connects but cannot open the
# forward dies and is restarted, instead of sitting there authenticated and
# carrying nothing. Without it the unit reports active while every question
# routed through it fails.
#
# ServerAlive* detects a peer that has gone away without closing the socket --
# a rebooted host, a dropped route -- within about ninety seconds. A forward
# that is dead but still bound is the failure this pair exists to shorten.
ExecStart=/usr/bin/ssh -N \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o ExitOnForwardFailure=yes \
    -o StrictHostKeyChecking=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -i /home/glenamac/.ssh/id_cass_tunnel \
    -L 8101:127.0.0.1:8099 \
    glenamac@winston.arc.gwu.edu

Restart=always
RestartSec=10

# NoNewPrivileges is deliberately NOT set here, which is unusual enough to say
# why. It sets PR_SET_NO_NEW_PRIVS, and the kernel then refuses any SELinux
# domain transition that would grant privilege. /usr/bin/ssh is labelled
# ssh_exec_t and carries such a transition, so with SELinux enforcing the exec
# is denied outright and systemd reports 203/EXEC -- a failure that reads as
# "binary not found" while the binary is present and executable.
#
# Little is given up. This is an ssh client run as an ordinary user with no
# setuid helpers in its path; the confinement that matters here is the
# restricted key on the far host, which limits what the session can do no
# matter what the local process could.
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
