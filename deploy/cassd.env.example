# Copy to /etc/cassd/cassd.env, owned by root, mode 0600.
#
# Every value here is deployment configuration rather than code. The token is a
# credential and is the reason for the mode: the unit file reads this, and the
# unit file is world-readable.

# Loopback only. The broker is on the same host; nothing off-box should reach
# this. The unit also denies non-local addresses, so a mistake here fails
# closed rather than opening a port.
CASS_BIND_ADDR=127.0.0.1:8099

# Generate with:  openssl rand -hex 32
CASS_AUTH_TOKEN=replace-me

# What may be read. The compiled default is /workspace,/tmp,/var/log/cass,
# which are the container's paths from compose.yaml and do not exist on a real
# host -- a daemon deployed on the defaults can see almost nothing and says
# nothing about why.
CASS_ALLOWED_ROOTS=/var/log,/tmp

# Start with listing and metadata only. filesystem.read and filesystem.tail are
# deliberately absent: they are a larger grant, and on this host they would
# mostly fail anyway, since the logs worth reading are 0600 root:root.
CASS_ENABLED_OPERATIONS=capabilities.describe,filesystem.list,filesystem.stat

# Inside StateDirectory=cassd, the only writable path the service has.
CASS_AUDIT_PATH=/var/lib/cassd/audit.log
