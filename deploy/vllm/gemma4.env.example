# Settings for the vllm-gemma4 user service. Installed copy:
#   /home/glenamac/.config/vllm/gemma4.env
# Change a value, then: systemctl --user restart vllm-gemma4
# MindRouter's "Max Concurrent" for backend ollama-sgtstubby should equal
# VLLM_MAX_NUM_SEQS, or the extra slots go unused (or requests queue in vLLM).

VLLM_VENV=/home/glenamac/venvs/vllm-cu128
VLLM_MODEL=google/gemma-4-31B-it
# The exact model snapshot on disk. Pinned so a cache refresh cannot swap the
# model underneath MindRouter; HF_HUB_OFFLINE stops any download at start.
VLLM_REVISION=842da3794eaa0b77d5f08bae87a17459d91ff475
VLLM_SERVED_NAME=gemma4-31b-vllm
VLLM_PORT=18080
VLLM_TP=4
VLLM_MAX_MODEL_LEN=244000
VLLM_GPU_MEM=0.90
VLLM_MAX_NUM_SEQS=8
VLLM_CHAT_TEMPLATE=/home/glenamac/vllm/tool_chat_template_gemma4.jinja
# The start script refuses to run if the template does not match.
VLLM_CHAT_TEMPLATE_SHA256=84af2a627a6e7489a9afe89e95dc6068d545999dd19fce89f34e9cedade71a35

HF_HOME=/home/ai_storage/glenamac/huggingface
HF_HUB_OFFLINE=1
CUDA_VISIBLE_DEVICES=0,1,2,3
