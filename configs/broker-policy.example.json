{
  "version": 1,
  "live_hosts": {
    "docker-harness": {
      "resources": [
        "system-log",
        "workspace-sample"
      ]
    },
    "sgtstubby.arc.gwu.edu": {
      "resources": [
        "log-dir",
        "log-dir-metadata",
        "patch-history"
      ]
    },
    "winston.arc.gwu.edu": {
      "resources": [
        "log-dir",
        "log-dir-metadata",
        "patch-history"
      ]
    }
  },
  "resources": {
    "system-log": {
      "operation": "filesystem.tail",
      "path": "/var/log/cass/system.log",
      "params": {
        "max_bytes": 8192
      }
    },
    "workspace-sample": {
      "operation": "filesystem.read",
      "path": "/workspace/sample.txt",
      "params": {
        "max_bytes": 4096
      }
    },
    "log-dir": {
      "operation": "filesystem.list",
      "path": "/var/log",
      "params": {
        "max_entries": 256
      }
    },
    "log-dir-metadata": {
      "operation": "filesystem.stat",
      "path": "/var/log"
    },
    "patch-history": {
      "operation": "filesystem.tail",
      "path": "/var/log/dnf.rpm.log",
      "params": {
        "max_bytes": 49152
      }
    }
  }
}
