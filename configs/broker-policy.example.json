{
  "version": 1,
  "live_hosts": {
    "docker-harness": {
      "resources": [
        "system-log",
        "workspace-sample"
      ]
    },
    "sgtstubby.arc.gwu.edu": {
      "resources": [
        "log-dir",
        "log-dir-metadata",
        "patch-history",
        "host-facts",
        "host-uptime",
        "host-diskfree",
        "host-network",
        "host-listeners"
      ]
    },
    "winston.arc.gwu.edu": {
      "resources": [
        "log-dir",
        "log-dir-metadata",
        "patch-history",
        "host-facts",
        "host-uptime",
        "host-diskfree",
        "host-network",
        "host-listeners"
      ]
    }
  },
  "resources": {
    "system-log": {
      "operation": "filesystem.tail",
      "path": "/var/log/cass/system.log",
      "params": {
        "max_bytes": 8192
      }
    },
    "workspace-sample": {
      "operation": "filesystem.read",
      "path": "/workspace/sample.txt",
      "params": {
        "max_bytes": 4096
      }
    },
    "log-dir": {
      "operation": "filesystem.list",
      "path": "/var/log",
      "params": {
        "max_entries": 256
      }
    },
    "log-dir-metadata": {
      "operation": "filesystem.stat",
      "path": "/var/log"
    },
    "patch-history": {
      "operation": "filesystem.tail",
      "path": "/var/log/dnf.rpm.log",
      "params": {
        "max_bytes": 24576
      }
    },
    "host-facts": {
      "operation": "host.info"
    },
    "host-uptime": {
      "operation": "host.uptime"
    },
    "host-diskfree": {
      "operation": "host.diskfree"
    },
    "host-network": {
      "operation": "host.network"
    },
    "host-listeners": {
      "operation": "host.listeners"
    }
  }
}
