{
  "version": 1,
  "live_hosts": {
    "docker-harness": {
      "resources": [
        "system-log",
        "workspace-sample"
      ]
    }
  },
  "resources": {
    "system-log": {
      "operation": "filesystem.tail",
      "path": "/var/log/cass/system.log",
      "params": {
        "max_bytes": 8192
      }
    },
    "workspace-sample": {
      "operation": "filesystem.read",
      "path": "/workspace/sample.txt",
      "params": {
        "max_bytes": 4096
      }
    }
  }
}
