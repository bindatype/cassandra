runtime/
dist/
.gocache/
.gomodcache/
*.log
!testdata/varlog/system.log
*.out

# Python bytecode from the evaluation harnesses. Two .pyc files were tracked
# and rewritten on every run, putting binary churn in the diff of any change
# that touched a harness.
__pycache__/

# Binaries a bare `go build ./cmd/...` drops in the repo root. The scripts here
# build into runtime/, but an ad-hoc build does not, and `git add -A` will
# happily commit 8MB of it.
/cass-agent
/cass-broker-exec
/cass-broker-plan
/cass-chat
/cass-notify

# Hermes/askcass working directories -- these hold live request/response
# data (inbox, outbox, generated reports), not source. A misdirected `cd`
# into this checkout has already written stray copies here once
# (2026-09-24); ignored so that mistake can never become a commit.
/inbox/
/outbox/
/reports/
